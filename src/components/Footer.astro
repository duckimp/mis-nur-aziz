---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="logo">
        <span class="logo-icon">MIS</span>
        <span class="logo-text">NUR - AZIZ</span>
      </div>
      <p class="footer-desc">
        Mewujudkan generasi yang berakhlak mulia, cerdas, dan bertaqwa melalui pendidikan berkualitas berlandaskan nilai-nilai Islam.
      </p>
    </div>

    <div class="footer-links">
      <h3>Tautan Cepat</h3>
      <ul>
        <li><a href="/">Beranda</a></li>
        <li><a href="/profil">Profil Sekolah</a></li>
        <li><a href="/akademik">Akademik</a></li>
        <li><a href="/guru">Guru & Staff</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h3>Informasi</h3>
      <ul>
        <li><a href="/galeri">Galeri Kegiatan</a></li>
        <li><a href="/ppdb">Pendaftaran (PPDB)</a></li>
        <li><a href="/kontak">Hubungi Kami</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <h3>Kontak Kami</h3>
      <p>Jl. Panglima Sudirman Gg. VI A Kel. Kebonsari Kulon, Kec. Kanigaran, Kota Probolinggo</p>
      <p>Email: mi.nuraziz2020@gmail.com</p>
      <p>WhatsApp: +62 852 3378 3768</p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {currentYear} MIS Nur - Aziz. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--text-main);
    color: var(--white);
    padding: 5rem 0 0;
    margin-top: 5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }

  .footer-brand .logo {
    color: var(--white);
    margin-bottom: 1.5rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-brand .logo-icon {
    background: var(--primary);
    color: var(--white);
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
  }

  .footer-desc {
    color: #94a3b8;
    max-width: 300px;
  }

  .footer h3 {
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
    color: var(--white);
  }

  .footer-links ul li {
    margin-bottom: 0.75rem;
  }

  .footer-links ul li a {
    color: #94a3b8;
  }

  .footer-links ul li a:hover {
    color: var(--primary);
    padding-left: 5px;
  }

  .footer-contact p {
    color: #94a3b8;
    margin-bottom: 0.75rem;
  }

  .footer-bottom {
    border-top: 1px solid #1e293b;
    padding: 2rem 0;
    text-align: center;
    color: #64748b;
    font-size: 0.9rem;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
