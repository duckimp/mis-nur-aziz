---
import Layout from './Layout.astro';

interface Props {
  title: string;
  activeMenu: string;
}

const { title, activeMenu } = Astro.props;
const email = Astro.locals.email;

const menuItems = [
  { name: 'Dashboard', icon: 'layout-dashboard', href: '/admin/dashboard' },
  { name: 'Berita', icon: 'newspaper', href: '/admin/berita' },
  { name: 'Galeri', icon: 'image', href: '/admin/galeri' },
  { name: 'Users', icon: 'users', href: '/admin/users' },
];
---

<Layout title={title}>
  <div class="flex min-h-screen bg-gray-100">
    <!-- Sidebar -->
    <aside class="w-64 bg-green-800 text-white hidden md:block">
      <div class="p-6 flex items-center gap-3">
        <img src="/images/logo.png" alt="Logo" class="h-10 w-10 bg-white rounded-full p-1" />
        <span class="font-bold text-lg">Admin MIS</span>
      </div>
      <nav class="mt-6">
        {menuItems.map((item) => (
          <a
            href={item.href}
            class={`flex items-center px-6 py-3 text-sm font-medium transition-colors hover:bg-green-700 ${
              activeMenu === item.name ? 'bg-green-900 border-l-4 border-white' : ''
            }`}
          >
            <span class="capitalize">{item.name}</span>
          </a>
        ))}
        <button
          id="logoutBtn"
          class="w-full flex items-center px-6 py-3 text-sm font-medium transition-colors hover:bg-red-700 mt-10"
        >
          Keluar
        </button>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col">
      <header class="bg-white shadow-sm h-16 flex items-center justify-between px-8">
        <h1 class="text-xl font-semibold text-gray-800">{title}</h1>
        <div class="flex items-center gap-4">
          <span class="text-sm text-gray-600">{email}</span>
        </div>
      </header>
      <div class="p-8 overflow-y-auto">
        <slot />
      </div>
    </main>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const logoutBtn = document.getElementById('logoutBtn');
  logoutBtn?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/admin/login';
  });
</script>