---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	showNavFooter?: boolean;
	ogImage?: string;
	ogUrl?: string;
	ogType?: string;
}

const { 
	title, 
	description = "Website Resmi MIS Nur Aziz - Mewujudkan Generasi Qur'ani dan Berprestasi",
	showNavFooter = true,
	ogImage,
	ogUrl,
	ogType = 'website',
} = Astro.props;

const siteUrl = 'https://mis-nur-aziz.vercel.app';
const resolvedOgImage = ogImage || `${siteUrl}/images/logo.png`;
const resolvedOgUrl = ogUrl || siteUrl;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/images/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | MIS Nur Aziz</title>

		<!-- Resource Hints: preconnect untuk mempercepat koneksi eksternal -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://wduoyaqmfkjnbkuqxsav.supabase.co" />

		<!-- Google Fonts: non-blocking via link (bukan @import di CSS) -->
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<!-- Open Graph / WhatsApp / Social Preview -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={`${title} | MIS Nur Aziz`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:url" content={resolvedOgUrl} />
		<meta property="og:site_name" content="MIS Nur Aziz" />
		<meta property="og:locale" content="id_ID" />
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | MIS Nur Aziz`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImage} />
	</head>
	<body>
		{showNavFooter && <Navbar />}
		<main>
			<slot />
		</main>
		{showNavFooter && <Footer />}

		<!-- ═══ Login Modal (tersedia di semua halaman publik) ═══ -->
		{showNavFooter && (
			<div id="login-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modal-title">
				<div class="modal-card">
					<!-- Close Button -->
					<button id="close-login-modal" class="modal-close" aria-label="Tutup">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
						</svg>
					</button>

					<!-- Header -->
					<div class="modal-header">
						<img src="/images/logo.png" alt="Logo MIS Nur Aziz" class="modal-logo" />
						<h2 id="modal-title">Admin Login</h2>
						<p>Masuk ke panel manajemen sekolah</p>
					</div>

					<!-- Form -->
					<form id="modal-login-form" class="modal-form" novalidate>
						<div class="field-group">
							<label for="login-email">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
								Email Admin
							</label>
							<input id="login-email" type="email" name="email" placeholder="email@sekolah.com" autocomplete="email" required />
						</div>
						<div class="field-group">
							<label for="login-password">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
								Password
							</label>
							<div class="password-wrap">
								<input id="login-password" type="password" name="password" placeholder="Masukkan password" autocomplete="current-password" required />
								<button type="button" id="toggle-password" class="eye-btn" aria-label="Tampilkan password">
									<svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
								</button>
							</div>
						</div>

						<!-- Error -->
						<div id="modal-error" class="modal-error" hidden>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
							<span id="modal-error-text"></span>
						</div>

						<button type="submit" id="modal-submit-btn" class="modal-submit">
							<span id="modal-btn-text">Masuk ke Dashboard</span>
							<svg id="modal-spinner" class="spin hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
						</button>
					</form>
				</div>
			</div>
		)}
	</body>
</html>

<script>
  import { supabase } from '../lib/supabase';

  const modal     = document.getElementById('login-modal');
  const closeBtn  = document.getElementById('close-login-modal');
  const form      = document.getElementById('modal-login-form') as HTMLFormElement | null;
  const errorBox  = document.getElementById('modal-error');
  const errorText = document.getElementById('modal-error-text');
  const submitBtn = document.getElementById('modal-submit-btn') as HTMLButtonElement | null;
  const btnText   = document.getElementById('modal-btn-text');
  const spinner   = document.getElementById('modal-spinner');
  const togglePwd = document.getElementById('toggle-password');
  const pwdInput  = document.getElementById('login-password') as HTMLInputElement | null;

  // ── Close helpers ──────────────────────────────────────────────────────────
  const closeModal = () => {
    modal?.classList.remove('active');
    document.body.style.overflow = '';
    if (errorBox) errorBox.hidden = true;
    form?.reset();
  };

  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) closeModal();
  });

  // ── Toggle password visibility ─────────────────────────────────────────────
  togglePwd?.addEventListener('click', () => {
    if (!pwdInput) return;
    const isText = pwdInput.type === 'text';
    pwdInput.type = isText ? 'password' : 'text';
    const icon = document.getElementById('eye-icon');
    if (icon) {
      icon.innerHTML = isText
        ? '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'
        : '<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>';
    }
  });

  // ── Submit ─────────────────────────────────────────────────────────────────
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !btnText || !spinner) return;

    const data = new FormData(form);
    const email    = data.get('email') as string;
    const password = data.get('password') as string;

    // Loading state
    submitBtn.disabled = true;
    btnText.textContent = 'Memverifikasi...';
    spinner?.classList.remove('hidden');
    if (errorBox) errorBox.hidden = true;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      // Error state
      submitBtn.disabled = false;
      btnText.textContent = 'Masuk ke Dashboard';
      spinner?.classList.add('hidden');
      if (errorBox && errorText) {
        errorText.textContent = error.message === 'Invalid login credentials'
          ? 'Email atau password salah.'
          : error.message;
        errorBox.hidden = false;
      }
    } else {
      btnText.textContent = 'Berhasil! Mengalihkan...';
      window.location.href = '/admin/dashboard';
    }
  });
</script>

<style>
  /* ── Backdrop ──────────────────────────────────────────────────────────── */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .modal-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  /* ── Card ──────────────────────────────────────────────────────────────── */
  .modal-card {
    position: relative;
    width: 100%;
    max-width: 420px;
    background: #ffffff;
    border-radius: 20px;
    padding: 2.5rem 2rem 2rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(255,255,255,0.1);
    transform: translateY(24px) scale(0.97);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .modal-backdrop.active .modal-card {
    transform: translateY(0) scale(1);
  }

  /* ── Close button ──────────────────────────────────────────────────────── */
  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: #f1f5f9;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .modal-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  /* ── Header ────────────────────────────────────────────────────────────── */
  .modal-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .modal-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin: 0 auto 1rem;
    display: block;
    filter: drop-shadow(0 4px 8px rgba(5, 150, 105, 0.2));
  }

  .modal-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.25rem;
  }

  .modal-header p {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
  }

  /* ── Form ──────────────────────────────────────────────────────────────── */
  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field-group label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #374151;
    letter-spacing: 0.02em;
  }

  .field-group input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    font-size: 0.875rem;
    color: #1e293b;
    background: #fafafa;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
  }

  .field-group input:focus {
    border-color: #059669;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);
    background: #fff;
  }

  /* ── Password toggle ───────────────────────────────────────────────────── */
  .password-wrap {
    position: relative;
  }

  .password-wrap input {
    padding-right: 2.75rem;
  }

  .eye-btn {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: #94a3b8;
    display: flex;
    align-items: center;
    padding: 0;
    transition: color 0.15s;
  }

  .eye-btn:hover { color: #059669; }

  /* ── Error ─────────────────────────────────────────────────────────────── */
  .modal-error {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    color: #dc2626;
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* ── Submit button ─────────────────────────────────────────────────────── */
  .modal-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, #059669, #047857);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: opacity 0.15s, transform 0.15s;
    margin-top: 0.25rem;
  }

  .modal-submit:hover:not(:disabled) {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .modal-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  /* ── Spinner ───────────────────────────────────────────────────────────── */
  .spin {
    animation: spin 0.8s linear infinite;
  }

  .hidden { display: none; }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
</style>
