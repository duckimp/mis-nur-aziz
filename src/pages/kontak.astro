---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hubungi Kami">
	<section class="page-header section">
		<div class="container animate-up">
			<span class="badge">Hubungi Kami</span>
			<h1>Ada Pertanyaan?</h1>
			<p>Kami siap membantu Anda mendapatkan informasi lebih lanjut tentang MIS Nur - Aziz.</p>
		</div>
	</section>

	<section class="contact section">
		<div class="container">
			<div class="contact-grid">
				<div class="contact-info animate-up">
					<div class="info-card glass">
						<div class="info-item">
							<div class="icon">📍</div>
							<div class="details">
								<h4>Alamat Lengkap</h4>
								<p>Jl. Panglima Sudirman Gg. VI A Kel. Kebonsari Kulon, Kec. Kanigaran, Kota Probolinggo, Jawa Timur (67214)</p>
							</div>
						</div>
						<div class="info-item">
							<div class="icon">📞</div>
							<div class="details">
								<h4>Telepon / WhatsApp</h4>
								<p>+62 852 3378 3768</p>
							</div>
						</div>
						<div class="info-item">
							<div class="icon">✉️</div>
							<div class="details">
								<h4>Email Sekolah</h4>
								<p>mi.nuraziz2020@gmail.com</p>
							</div>
						</div>
						<div class="info-item">
							<div class="icon">🕒</div>
							<div class="details">
								<h4>Jam Operasional</h4>
								<p>Senin - Sabtu: 07.00 - 14.00 WIB</p>
							</div>
						</div>
					</div>

					<div class="contact-btns">
						<a href="https://wa.me/6285233783768" target="_blank" class="btn btn-primary whatsapp-btn">
							Hubungi WhatsApp
						</a>
						<a href="mailto:mi.nuraziz2020@gmail.com" class="btn glass email-btn">
							Kirim Email
						</a>
					</div>
				</div>

				<div class="contact-map animate-up">
					<div class="map-container glass">
						<!-- Gmaps Embed Placeholder -->
						<div class="map-placeholder">
							<iframe 
								src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3953.2923334745783!2d113.2252565!3d-7.7587888000000005!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd7ad8ea19ff379%3A0xb8c89473a70a9be2!2sMI%20Nur%20Aziz!5e0!3m2!1sid!2sid!4v1777715020752!5m2!1sid!2sid" 
								width="100%" 
								height="450" 
								style="border:0; border-radius: 1rem;" 
								allowfullscreen="" 
								loading="lazy" 
								referrerpolicy="no-referrer-when-downgrade">
							</iframe>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		background: linear-gradient(rgba(5, 150, 105, 0.05), rgba(5, 150, 105, 0.05));
		padding-top: 150px;
		text-align: center;
	}

	.badge {
		color: var(--primary);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-size: 0.875rem;
		margin-bottom: 1rem;
		display: block;
	}

	.page-header h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 4rem;
		align-items: flex-start;
	}

	.info-card {
		padding: 3rem;
		border-radius: 2rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.info-item {
		display: flex;
		gap: 1.5rem;
	}

	.info-item .icon {
		font-size: 1.5rem;
		background: #d1fae5;
		width: 50px;
		height: 50px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 1rem;
		flex-shrink: 0;
	}

	.info-item h4 {
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}

	.info-item p {
		color: var(--text-muted);
	}

	.contact-btns {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
	}

	.whatsapp-btn {
		flex: 1;
		text-align: center;
	}

	.email-btn {
		flex: 1;
		text-align: center;
		color: var(--primary) !important;
	}

	.map-container {
		padding: 1rem;
		border-radius: 2rem;
	}

	@media (max-width: 992px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.page-header h1 { font-size: 2.5rem; }
		.contact-btns { flex-direction: column; }
	}
</style>
