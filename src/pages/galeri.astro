---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: galleryData } = await supabase
  .from('gallery')
  .select('*')
  .order('created_at', { ascending: false });

const galleryItems = galleryData || [];
---

<Layout title="Galeri Foto">
	<section class="page-header section">
		<div class="container animate-up">
			<span class="badge">Dokumentasi</span>
			<h1>Galeri Kegiatan</h1>
			<p>Momen-momen berharga dan aktivitas seru siswa-siswi MI Nur Aziz.</p>
		</div>
	</section>

	<section class="gallery section">
		<div class="container">
			<div class="gallery-grid">
				{galleryItems.map((item, index) => {
					const tagList = item.tags
						? item.tags.split(',').map((t: string) => t.trim()).filter(Boolean)
						: [];
					return (
						<div class="gallery-item animate-up" style={{ animationDelay: `${index * 0.1}s` }}>
							<div class="gallery-img-container" data-index={index} data-category={item.category} data-tags={item.tags || ''}>
								<img src={item.image_url} alt={item.category} class="gallery-img" loading="lazy" decoding="async" width="400" height="400" />
								<div class="gallery-overlay">
									<span class="category-badge">{item.category}</span>
									<h3>{item.category}</h3>
									{tagList.length > 0 && (
										<div class="tag-list">
											{tagList.map((tag: string) => (
												<span class="tag-chip">#{tag}</span>
											))}
										</div>
									)}
									<button class="view-btn">Lihat Foto</button>
								</div>
							</div>
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<!-- Lightbox -->
	<div id="lightbox" class="lightbox">
		<span class="close-lightbox">&times;</span>
		<div class="lightbox-content">
			<img id="lightbox-img" src="" alt="Gallery Preview" />
			<div class="lightbox-footer">
				<div id="lightbox-caption"></div>
				<div id="lightbox-tags"></div>
			</div>
		</div>
	</div>
</Layout>

<style>
	.page-header {
		background: linear-gradient(rgba(5, 150, 105, 0.05), rgba(5, 150, 105, 0.05));
		padding-top: 150px;
		text-align: center;
	}

	.badge {
		color: var(--primary);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-size: 0.875rem;
		margin-bottom: 1rem;
		display: block;
	}

	.page-header h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.gallery-item {
		border-radius: 1.5rem;
		overflow: hidden;
		position: relative;
		aspect-ratio: 1;
		cursor: pointer;
	}

	.gallery-img-container {
		width: 100%;
		height: 100%;
	}

	.gallery-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}

	.gallery-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(to top, rgba(5, 150, 105, 0.9), transparent);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 2rem;
		opacity: 0;
		transition: var(--transition);
	}

	.gallery-item:hover .gallery-overlay {
		opacity: 1;
	}

	.gallery-item:hover .gallery-img {
		transform: scale(1.1);
	}

	.gallery-overlay h3 {
		color: white;
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
	}

	.category-badge {
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(6px);
		border: 1px solid rgba(255,255,255,0.3);
		color: white;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		margin-bottom: 0.5rem;
		align-self: flex-start;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin-bottom: 0.5rem;
	}

	.tag-chip {
		background: rgba(5, 150, 105, 0.7);
		color: white;
		font-size: 0.65rem;
		font-weight: 600;
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		border: 1px solid rgba(255,255,255,0.2);
		backdrop-filter: blur(4px);
	}

	.view-btn {
		background: white;
		color: var(--primary);
		border: none;
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		font-weight: 700;
		font-size: 0.875rem;
		align-self: flex-start;
		margin-top: 1rem;
	}

	/* Lightbox Styles */
	.lightbox {
		display: none;
		position: fixed;
		z-index: 2000;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.95);
		justify-content: center;
		align-items: center;
		flex-direction: column;
	}

	.lightbox-content {
		max-width: 90%;
		max-height: 80%;
		text-align: center;
	}

	#lightbox-img {
		max-width: 100%;
		max-height: 80vh;
		border-radius: 1rem;
		box-shadow: var(--shadow-lg);
	}

	.lightbox-footer {
		margin-top: 1.5rem;
		text-align: center;
	}

	#lightbox-caption {
		color: white;
		font-size: 1.4rem;
		font-family: 'Outfit', sans-serif;
		font-weight: 700;
		margin-bottom: 0.6rem;
	}

	#lightbox-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		justify-content: center;
	}

	#lightbox-tags .lb-tag {
		background: rgba(5, 150, 105, 0.75);
		color: white;
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(6px);
	}

	.close-lightbox {
		position: absolute;
		top: 30px;
		right: 40px;
		color: white;
		font-size: 40px;
		font-weight: bold;
		cursor: pointer;
	}

	@media (max-width: 992px) {
		.gallery-grid { grid-template-columns: 1fr 1fr; }
	}

	@media (max-width: 768px) {
		.page-header h1 { font-size: 2.5rem; }
		.gallery-grid { grid-template-columns: 1fr; }
	}
</style>

<script>
	const items = document.querySelectorAll('.gallery-img-container');
	const lightbox = document.getElementById('lightbox');
	const captionEl = document.getElementById('lightbox-caption');
	const tagsEl = document.getElementById('lightbox-tags');
	const closeBtn = document.querySelector('.close-lightbox');

	items.forEach(item => {
		item.addEventListener('click', () => {
			const category = (item as HTMLElement).dataset.category || item.querySelector('h3')?.textContent || '';
			const rawTags = (item as HTMLElement).dataset.tags || '';
			const imgSrc = item.querySelector('img')?.getAttribute('src') || '';
			const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
			
			if (lightbox && captionEl && lbImg) {
				lbImg.src = imgSrc;
				captionEl.textContent = category;

				// Render hashtag chips di lightbox
				if (tagsEl) {
					tagsEl.innerHTML = '';
					if (rawTags.trim()) {
						rawTags.split(',').forEach(tag => {
							const t = tag.trim();
							if (t) {
								const chip = document.createElement('span');
								chip.className = 'lb-tag';
								chip.textContent = `#${t}`;
								tagsEl.appendChild(chip);
							}
						});
					}
				}

				lightbox.style.display = 'flex';
			}
		});
	});

	closeBtn?.addEventListener('click', () => {
		if (lightbox) lightbox.style.display = 'none';
	});

	lightbox?.addEventListener('click', (e) => {
		if (e.target === lightbox) {
			lightbox.style.display = 'none';
		}
	});
</script>
