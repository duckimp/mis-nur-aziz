---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { DashboardCharts } from '../../components/admin/DashboardCharts';
---

<AdminLayout title="Dashboard" activeMenu="Dashboard">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500">
      <p class="text-sm text-gray-500 font-medium">Total Berita</p>
      <p class="text-2xl font-bold text-gray-800">12</p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-blue-500">
      <p class="text-sm text-gray-500 font-medium">Total Foto</p>
      <p class="text-2xl font-bold text-gray-800">45</p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-orange-500">
      <p class="text-sm text-gray-500 font-medium">Total Guru</p>
      <p class="text-2xl font-bold text-gray-800">20</p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-purple-500">
      <p class="text-sm text-gray-500 font-medium">Total Siswa</p>
      <p class="text-2xl font-bold text-gray-800">150</p>
    </div>
  </div>

  <DashboardCharts client:load />
</AdminLayout>
