---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: newsData } = await supabase
  .from('news')
  .select('*')
  .order('date', { ascending: false })
  .limit(4);

const news = newsData || [];
---

<Layout title="Beranda">
	<!-- ... Hero and Visi Sections stay the same ... -->
	<!-- Hero Section -->
	<section class="hero">
		<!-- Full-width background image with overlay -->
		<div class="hero-bg">
			<img 
				src="/images/hero.jpg" 
				alt="MI Nur Aziz Background" 
				class="hero-bg-img"
				fetchpriority="high"
			/>
			<div class="hero-overlay"></div>
		</div>

		<div class="container hero-container animate-up">
			<div class="hero-content">
				<span class="hero-badge">SELAMAT DATANG DI MIS NUR - AZIZ</span>
				<h1>Mencetak Generasi yang Berakhlak</h1>
				<p>Wujudkan masa depan cemerlang putra-putri Anda dengan pendidikan berkualitas yang mengintegrasikan ilmu pengetahuan dan nilai-nilai keagamaan.</p>
				<div class="hero-btns">
					<a href="/ppdb" class="btn btn-primary">Info Pendaftaran</a>
					<a href="/profil" class="btn btn-outline-white">Pelajari Lebih Lanjut</a>
				</div>
			</div>
			
			<div class="hero-badge-floating">
				<div class="glass-box">Unggul & Berakhlak</div>
			</div>
		</div>
	</section>

	<!-- Visi Section -->
	<section class="visi section">
		<div class="container text-center">
			<h2 class="section-title">Visi Kami</h2>
			<div class="visi-card glass animate-up">
				<p class="visi-text">
					"Terwujudnya Generasi yang ber-Akhlak, ber-Imtaq, serta Berwawasan Lingkungan."
				</p>
			</div>
		</div>
	</section>

	<!-- Berita Section -->
	<section class="berita section" style="background: #fff;">
		<div class="container">
			<div class="section-header">
				<h2 class="section-title">Berita Terbaru</h2>
				<a href="/berita" class="view-all">Lihat Semua &rarr;</a>
			</div>
			<div class="news-grid">
				{news.map(item => {
					// Bersihkan tag [img:...] dari excerpt di beranda jika ada
					const cleanDesc = item.description 
						? item.description.split('\n').filter((l: string) => !l.trim().startsWith('[img:')).join(' ')
						: '';
					const excerpt = cleanDesc.length > 120 ? cleanDesc.slice(0, 120) + '...' : cleanDesc;
					return (
						<a href={`/berita/${item.slug || item.id}`} class="news-card">
							<div class="news-img-container">
								<img 
									src={item.image_url} 
									alt={item.title} 
									class="news-img-actual-card"
									loading="lazy"
									decoding="async"
									width="400"
									height="200"
								/>
							</div>
							<div class="news-content">
								<span class="news-date">{item.date}</span>
								<h3>{item.title}</h3>
								<p>{excerpt}</p>
							</div>
						</a>
					);
				})}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="cta-section section">
		<div class="container">
			<div class="cta-card">
				<h2>Siap Bergabung Bersama Kami?</h2>
				<p>Daftarkan putra-putri Anda sekarang dan jadilah bagian dari perjalanan menuju generasi Qur'ani.</p>
				<a href="/ppdb" class="btn btn-accent">Daftar Sekarang</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		min-height: 80vh;
		display: flex;
		align-items: center;
		padding-top: 110px;
		padding-bottom: 60px;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
	}

	.hero-bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(15, 23, 42, 0.4) 100%);
	}

	.hero-container {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 2rem;
		align-items: center;
		width: 100%;
	}

	.hero-content {
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.15);
		padding: 3.5rem 3rem;
		border-radius: 2rem;
		max-width: 650px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
		color: white;
	}

	.hero-badge {
		background: rgba(5, 150, 105, 0.3);
		color: #ffffff;
		border: 1px solid rgba(5, 150, 105, 0.4);
		padding: 0.5rem 1rem;
		border-radius: 2rem;
		font-weight: 600;
		font-size: 0.875rem;
		margin-bottom: 1.5rem;
		display: inline-block;
	}

	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: 1.5rem;
		color: #ffffff;
		line-height: 1.15;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
	}

	.hero p {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.85);
		margin-bottom: 2.5rem;
		max-width: 600px;
		line-height: 1.6;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
	}

	.hero-btns {
		display: flex;
		gap: 1rem;
	}

	.btn-outline-white {
		border: 1.5px solid rgba(255, 255, 255, 0.5);
		background: transparent;
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 0.5rem;
		font-weight: 600;
		font-family: 'Outfit', sans-serif;
		cursor: pointer;
		transition: var(--transition);
		display: inline-block;
	}

	.btn-outline-white:hover {
		background: white;
		color: var(--primary);
		border-color: white;
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.hero-badge-floating {
		display: flex;
		justify-content: flex-end;
		align-items: flex-end;
		height: 100%;
		padding-bottom: 2rem;
	}

	.glass-box {
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		padding: 1.25rem 2.25rem;
		border-radius: 1.25rem;
		color: white;
		font-weight: 700;
		font-size: 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.25);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
		letter-spacing: 0.5px;
	}

	.section-title {
		text-align: center;
		font-size: 2.5rem;
		margin-bottom: 3rem;
		position: relative;
	}

	.section-title::after {
		content: '';
		position: absolute;
		bottom: -10px;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 4px;
		background: var(--primary);
		border-radius: 2px;
	}

	.text-center { text-align: center; }

	.visi-card {
		padding: 4rem;
		border-radius: 2rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.visi-text {
		font-size: 1.5rem;
		font-style: italic;
		font-family: 'Outfit', sans-serif;
		color: var(--primary);
		font-weight: 500;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 3rem;
	}

	.section-header .section-title {
		margin-bottom: 0;
		text-align: left;
	}

	.section-header .section-title::after {
		left: 0;
		transform: none;
	}

	.view-all {
		color: var(--primary);
		font-weight: 600;
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	.news-card {
		background: var(--white);
		border-radius: 1.5rem;
		overflow: hidden;
		box-shadow: var(--shadow-md);
		transition: var(--transition);
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.news-card:hover {
		transform: translateY(-10px);
		box-shadow: var(--shadow-lg);
	}

	.news-img-container {
		height: 200px;
		overflow: hidden;
	}

	.news-img-actual-card {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}

	.news-card:hover .news-img-actual-card {
		transform: scale(1.1);
	}

	.news-content {
		padding: 1.5rem;
	}

	.news-date {
		color: var(--text-muted);
		font-size: 0.875rem;
		margin-bottom: 0.5rem;
		display: block;
	}

	.news-card h3 {
		font-size: 1.25rem;
		margin-bottom: 1rem;
	}

	.cta-card {
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		color: white;
		padding: 5rem;
		border-radius: 2.5rem;
		text-align: center;
	}

	.cta-card h2 {
		font-size: 3rem;
		margin-bottom: 1.5rem;
	}

	.cta-card p {
		font-size: 1.25rem;
		margin-bottom: 2.5rem;
		opacity: 0.9;
	}

	@media (max-width: 992px) {
		.hero {
			min-height: auto;
			padding-top: 110px;
			padding-bottom: 80px;
		}
		.hero-container {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
		.hero-content {
			padding: 2.5rem 2rem;
			margin: 0 auto;
			text-align: center;
		}
		.hero-badge-floating {
			justify-content: center;
			padding-bottom: 0;
		}
		.hero-btns {
			justify-content: center;
		}
		.hero h1 { font-size: 2.5rem; }
		.news-grid { grid-template-columns: 1fr 1fr; }
	}

	@media (max-width: 768px) {
		.news-grid { grid-template-columns: 1fr; }
		.cta-card { padding: 3rem 1.5rem; }
		.cta-card h2 { font-size: 2rem; }
	}

	@media (max-width: 576px) {
		.hero-content {
			padding: 2rem 1.25rem;
			border-radius: 1.5rem;
		}
		.hero-btns {
			flex-direction: column;
			gap: 0.75rem;
		}
		.hero-btns .btn, .hero-btns .btn-outline-white {
			width: 100%;
			text-align: center;
		}
		.hero h1 {
			font-size: 2rem;
		}
	}
</style>
