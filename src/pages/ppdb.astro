---
import Layout from '../layouts/Layout.astro';
import { createServerClient, parseCookieHeader } from '@supabase/ssr';

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll() {
        const h = Astro.request.headers.get('cookie');
        if (!h) return [];
        return parseCookieHeader(h);
      },
      setAll(list) {
        list.forEach(({ name, value, options }) => Astro.cookies.set(name, value, options));
      },
    },
  }
);

// Ambil status SPMB dari DB
const { data: settings } = await supabase
  .from('spmb_settings')
  .select('*')
  .eq('id', 1)
  .single();

const spmbSettings = settings || {
  is_open: false,
  tahun_ajaran: '2026/2027',
  kuota: 50,
};
---

<Layout
  title="SPMB / PPDB Online - MIS Nur Aziz"
  description={`Penerimaan Murid Baru MIS Nur Aziz Tahun Ajaran ${spmbSettings.tahun_ajaran}. Daftar secara online, cepat, dan mudah.`}
  ogUrl="https://mis-nur-aziz.vercel.app/ppdb"
>
  <!-- Hero Section -->
  <section class="ppdb-hero">
    <div class="container">
      <div class="ppdb-hero-content animate-up">
        <div class="badge-hero">
          <svg class="hero-badge-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          <span>Penerimaan Murid Baru</span>
        </div>
        <h1>SPMB / PPDB Online<br/><span>MIS Nur Aziz</span></h1>
        <p>
          Tahun Ajaran <strong>{spmbSettings.tahun_ajaran}</strong>. Daftarkan putra/putri Anda
          sekarang secara online dengan mudah, transparan, dan cepat.
        </p>

        <!-- Status Badge -->
        <div class="hero-status-box">
          {spmbSettings.is_open ? (
            <div class="status-pill open">
              <span class="dot"></span>
              <span>Pendaftaran Sedang DIBUKA</span>
            </div>
          ) : (
            <div class="status-pill closed">
              <span class="dot"></span>
              <span>Pendaftaran Belum Dibuka</span>
            </div>
          )}
        </div>

        <!-- CTA Buttons -->
        <div class="hero-cta">
          {spmbSettings.is_open ? (
            <a href="/spmb" class="btn btn-primary btn-lg btn-with-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              <span>Daftar Sekarang</span>
            </a>
          ) : (
            <button class="btn btn-disabled btn-lg" disabled>
              <span>Pendaftaran Belum Dibuka</span>
            </button>
          )}
          <a href="/spmb/cek-status" class="btn btn-outline btn-lg btn-with-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Cek Status Pendaftaran</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alur Pendaftaran -->
  <section class="ppdb-flow section">
    <div class="container">
      <div class="section-header animate-up">
        <span class="flow-badge">Panduan</span>
        <h2>Alur Pendaftaran Online</h2>
        <p>Ikuti langkah berikut untuk menyelesaikan pendaftaran SPMB secara online</p>
      </div>

      <div class="steps-grid animate-up">
        <div class="step-card">
          <div class="step-num">1</div>
          <div class="step-icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h4>Isi Formulir Online</h4>
          <p>Klik tombol "Daftar Sekarang" dan isi formulir dengan data lengkap dan benar.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <div class="step-icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <h4>Upload Berkas</h4>
          <p>Siapkan dan upload foto Kartu Keluarga (KK) dan Akta Kelahiran yang jelas.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <div class="step-icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
          </div>
          <h4>Simpan ID Registrasi</h4>
          <p>Setelah berhasil, simpan ID Registrasi (SPMB-XXXX-XXX) untuk cek status.</p>
        </div>
        <div class="step-card">
          <div class="step-num">4</div>
          <div class="step-icon-svg">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h4>Pantau Status</h4>
          <p>Pantau status via halaman cek status. Notifikasi juga dikirim via WhatsApp.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Syarat Pendaftaran -->
  <section class="ppdb-syarat section" style="background: var(--background);">
    <div class="container">
      <div class="syarat-grid">
        <div class="syarat-card animate-up">
          <div class="card-title-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
            <h3>Syarat Pendaftaran</h3>
          </div>
          <ul class="syarat-list">
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Usia minimal 6 tahun</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Tidak aktif di SD/MI lain</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Memiliki Kartu Keluarga (KK)</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Memiliki Akta Kelahiran</span>
            </li>
            <li>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Nomor WhatsApp aktif orang tua</span>
            </li>
          </ul>
        </div>
        <div class="syarat-card animate-up">
          <div class="card-title-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            <h3>Berkas yang Diupload</h3>
          </div>
          <ul class="syarat-list">
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <span>Foto/Scan Kartu Keluarga (KK)</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <span>Foto/Scan Akta Kelahiran</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span>Format: JPG, PNG, atau WEBP</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span>Ukuran maks: 5MB per file</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Foto otomatis dikonversi ke WebP</span>
            </li>
          </ul>
        </div>
        <div class="syarat-card animate-up">
          <div class="card-title-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <h3>Informasi Penting</h3>
          </div>
          <ul class="syarat-list">
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              <span>Tahun Ajaran: {spmbSettings.tahun_ajaran}</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Lokasi: MIS Nur Aziz</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span>Pendaftaran Bebas Biaya (Gratis)</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              <span>Notifikasi via WhatsApp</span>
            </li>
            <li>
              <svg class="bullet-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Proses Verifikasi: 1-3 hari kerja</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Bottom -->
  <section class="ppdb-cta section" style="background: linear-gradient(135deg, var(--primary), var(--primary-hover));">
    <div class="container">
      <div class="cta-content animate-up">
        <h2>Siap Bergabung Bersama Kami?</h2>
        <p>Daftarkan putra/putri Anda sekarang dan jadilah bagian dari keluarga besar MIS Nur Aziz.</p>
        <div class="cta-btns">
          {spmbSettings.is_open ? (
            <a href="/spmb" class="btn btn-white btn-lg btn-with-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              <span>Daftar Sekarang</span>
            </a>
          ) : (
            <a href="/kontak" class="btn btn-white btn-lg btn-with-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>Hubungi Sekolah</span>
            </a>
          )}
          <a href="/spmb/cek-status" class="btn btn-outline-white btn-lg btn-with-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Cek Status</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Hero ─── */
  .ppdb-hero {
    padding-top: 140px;
    padding-bottom: 3rem;
    border-bottom: 1px solid #d1fae5;
    position: relative;
    overflow: hidden;
  }
  .ppdb-hero-content { max-width: 700px; }
  .ppdb-hero-content h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0.75rem 0;
    color: var(--text-main);
    line-height: 1.1;
  }
  .ppdb-hero-content h1 span { color: var(--primary); }
  .ppdb-hero-content p { color: var(--text-muted); font-size: 1.1rem; max-width: 580px; margin-bottom: 1.5rem; }

  .badge-hero {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.45rem !important;
    background: #d1fae5;
    color: #065f46;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    width: fit-content;
  }
  .hero-badge-icon {
    flex-shrink: 0;
    color: #059669;
  }

  .flow-badge {
    display: inline-block;
    color: var(--primary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .btn-with-icon {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.5rem !important;
    line-height: 1 !important;
  }
  .btn-with-icon svg {
    flex-shrink: 0;
  }

  .hero-status-box { margin-bottom: 1.5rem; }
  .status-pill {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.5rem !important;
    padding: 0.5rem 1.25rem;
    border-radius: 30px;
    font-weight: 700;
    font-size: 0.9rem;
    width: fit-content;
  }
  .status-pill.open { background: #d1fae5; color: #065f46; border: 2px solid #10b981; }
  .status-pill.closed { background: #fee2e2; color: #991b1b; border: 2px solid #f87171; }
  .dot {
    width: 8px; height: 8px;
    border-radius: 50%; background: currentColor;
    animation: blink 1.5s infinite;
    flex-shrink: 0;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }

  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-lg { padding: 0.875rem 2rem; font-size: 1rem; }
  .btn-disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; border-radius: 12px; border: none; }

  /* ─── Flow Steps ─── */
  .ppdb-flow { background: white; }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .step-card {
    position: relative;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    text-align: center;
    transition: var(--transition);
  }
  .step-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--primary); }
  .step-num {
    position: absolute;
    top: -12px; left: 50%; transform: translateX(-50%);
    background: var(--primary);
    color: white;
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem; font-weight: 800;
  }
  .step-icon-svg {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    margin: 0.75rem 0 1rem;
  }
  .step-card h4 { font-size: 1rem; margin-bottom: 0.5rem; }
  .step-card p { font-size: 0.875rem; color: var(--text-muted); margin: 0; }

  /* ─── Syarat ─── */
  .syarat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .syarat-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem;
    transition: var(--transition);
  }
  .syarat-card:hover { box-shadow: var(--shadow-md); }
  
  .card-title-icon {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.6rem !important;
    color: var(--primary);
    margin-bottom: 1.25rem;
  }
  .card-title-icon svg {
    flex-shrink: 0;
  }
  .card-title-icon h3 {
    font-size: 1.15rem;
    margin: 0 !important;
    font-weight: 700;
  }

  .syarat-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0;
    margin: 0;
  }
  .syarat-list li {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start !important;
    gap: 0.65rem !important;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.4;
