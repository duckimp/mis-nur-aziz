---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { slug } = Astro.params;

// Fetch artikel berdasarkan slug
const { data: article } = await supabase
  .from('news')
  .select('*')
  .eq('slug', slug)
  .single();

// Jika tidak ditemukan, redirect ke halaman berita
if (!article) {
  return Astro.redirect('/berita');
}

// Format tanggal
const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
};

const siteUrl = 'https://mis-nur-aziz.vercel.app';
const pageUrl = `${siteUrl}/berita/${slug}`;
const shareText = encodeURIComponent(`${article.title}\n\nBaca selengkapnya: ${pageUrl}`);
const waUrl = `https://wa.me/?text=${shareText}`;

// Deskripsi untuk OG (max 160 karakter)
const ogDescription = article.description
  ? article.description.slice(0, 160)
  : `Baca berita terbaru dari MIS Nur Aziz: ${article.title}`;

// Fetch berita terkait (3 berita terbaru selain ini)
const { data: relatedData } = await supabase
  .from('news')
  .select('id, title, slug, image_url, date')
  .neq('slug', slug)
  .order('date', { ascending: false })
  .limit(3);

const related = relatedData || [];

const formattedDate = formatDate(article.date);
---

<Layout 
  title={article.title}
  description={ogDescription}
  ogImage={article.image_url}
  ogUrl={pageUrl}
  ogType="article"
>
  <!-- Hero Image -->
  <div class="article-hero">
    <img src={article.image_url} alt={article.title} class="hero-img" />
    <div class="hero-gradient"></div>
  </div>

  <div class="article-layout">
    <!-- Main Content -->
    <main class="article-main">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">Beranda</a>
        <span class="sep">›</span>
        <a href="/berita">Berita</a>
        <span class="sep">›</span>
        <span>{article.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        <div class="article-meta">
          <span class="meta-date">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            {formattedDate}
          </span>
          {article.author && (
            <span class="meta-author">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              {article.author}
            </span>
          )}
        </div>
        <h1 class="article-title">{article.title}</h1>
      </header>

      <!-- Article Content -->
      <div class="article-content">
        {article.description?.split('\n').map((para: string) => {
          const trimmed = para.trim();
          if (!trimmed) return <br />;
          if (trimmed.startsWith('[img:') && trimmed.endsWith(']')) {
            const imgUrl = trimmed.slice(5, -1).trim();
            return (
              <figure class="article-inline-figure">
                <img src={imgUrl} alt={article.title} loading="lazy" class="article-inline-img" />
              </figure>
            );
          }
          return <p>{trimmed}</p>;
        })}
      </div>

      <!-- Share & Back Section -->
      <div class="article-footer">
        <a href="/berita" class="back-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Kembali ke Berita
        </a>

        <div class="share-group">
          <span class="share-label">Bagikan:</span>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="share-wa" aria-label="Bagikan ke WhatsApp">
            <!-- WhatsApp SVG icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
            Share ke WhatsApp
          </a>
        </div>
      </div>
    </main>

    <!-- Sidebar: Berita Terkait -->
    {related.length > 0 && (
      <aside class="article-sidebar">
        <h3 class="sidebar-title">Berita Lainnya</h3>
        <div class="related-list">
          {related.map(item => (
            <a href={`/berita/${item.slug || item.id}`} class="related-card">
              <img src={item.image_url} alt={item.title} class="related-img" loading="lazy" />
              <div class="related-body">
                <p class="related-title">{item.title}</p>
                <span class="related-date">
                  {item.date ? new Date(item.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : ''}
                </span>
              </div>
            </a>
          ))}
        </div>
      </aside>
    )}
  </div>
</Layout>

<style>
  .article-inline-figure {
    margin: 2rem auto;
    width: 70%;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    background: #f1f5f9;
  }

  .article-inline-img {
    width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 768px) {
    .article-inline-figure {
      width: 100%;
    }
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .article-hero {
    position: relative;
    height: 480px;
    overflow: hidden;
    margin-top: 80px; /* Offset navbar */
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 100%);
  }

  /* ── Layout ───────────────────────────────────────────────────────────── */
  .article-layout {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }

  /* ── Main Article ─────────────────────────────────────────────────────── */
  .article-main {
    background: white;
    border-radius: 1.5rem;
    padding: 2.5rem;
    margin-top: -60px;
    position: relative;
    z-index: 10;
    box-shadow: 0 8px 40px rgba(0,0,0,0.1);
  }

  /* ── Breadcrumb ───────────────────────────────────────────────────────── */
  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--primary);
    font-weight: 500;
    text-decoration: none;
  }

  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span:last-child {
    color: #64748b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 260px;
  }

  .sep { color: #cbd5e1; }

  /* ── Article Header ───────────────────────────────────────────────────── */
  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .meta-date, .meta-author {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 500;
  }

  .article-title {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    margin: 0;
    font-family: 'Outfit', sans-serif;
  }

  /* ── Article Content ──────────────────────────────────────────────────── */
  .article-content {
    font-size: 1.05rem;
    color: #374151;
    line-height: 1.85;
  }

  .article-content p {
    margin-bottom: 1.25rem;
  }

  /* ── Footer ───────────────────────────────────────────────────────────── */
  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f1f5f9;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    transition: all 0.2s;
  }

  .back-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(5,150,105,0.04);
  }

  .share-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .share-label {
    font-size: 0.82rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .share-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #25D366;
    color: white;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1.25rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    font-family: 'Inter', sans-serif;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
  }

  .share-wa:hover {
    background: #1da851;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
  }

  /* ── Sidebar ──────────────────────────────────────────────────────────── */
  .article-sidebar {
    padding-top: 2rem;
    position: sticky;
    top: 100px;
  }

  .sidebar-title {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--primary);
    display: inline-block;
    font-family: 'Outfit', sans-serif;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .related-card {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    padding: 0.75rem;
    border-radius: 12px;
    border: 1px solid #f1f5f9;
    background: white;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }

  .related-card:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    border-color: rgba(5,150,105,0.2);
  }

  .related-img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .related-body {
    flex: 1;
    overflow: hidden;
  }

  .related-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: #374151;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.35rem;
  }

  .related-card:hover .related-title { color: var(--primary); }

  .related-date {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .article-sidebar {
      position: static;
      padding-top: 0;
    }
    .related-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
  }

  @media (max-width: 640px) {
    .article-hero { height: 240px; }
    .article-main {
      margin-top: -30px;
      padding: 1.5rem;
      border-radius: 1.25rem;
    }
    .article-layout { padding: 0 1rem 3rem; }
    .article-title { font-size: 1.5rem; }
    .article-content { font-size: 1rem; }
    .article-footer { flex-direction: column; align-items: stretch; }
    .share-wa { justify-content: center; }
    .related-list { grid-template-columns: 1fr; }
  }
</style>
